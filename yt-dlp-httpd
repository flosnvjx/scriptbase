#!/usr/bin/env python
"""
yt-dlp-httpd: A zero-file reverse proxy for yt-dlp streams.

SYNOPSIS
    Default Mode (Read from JSON/JSONL file or stdin):
        python yt_dlp_httpd.py <metadata.json|jsonl|- >

    Wrapper Mode (Invoke yt-dlp directly):
        yt-dlp-httpd [yt-dlp options] <URL>

DESCRIPTION
    A memory-only reverse proxy that serves streams extracted by yt-dlp.
    It supports HTTP Range requests (for video seeking), automatically maps
    MIME types, and handles upstream HTTP headers (Cookies, Referer, etc.).
    In Wrapper Mode, it intercepts yt-dlp CLI arguments, injects `--dump-json`
    if missing, and parses the output on the fly. If an upstream URL expires
    (e.g., HTTP 403), it automatically re-invokes yt-dlp in the background to
    refresh the routing table without interrupting the client.

ROBUST STREAM HANDLING (this revision)
    Two failure modes that a naive proxy silently mis-serves are now handled:

    1. Empty / early-closed reply. The upstream accepts the request (200/206)
       but closes the connection before delivering the byte count it declared
       (Content-Length / Content-Range). Because Starlette emits the response
       headers the moment the handler returns, a mid-stream break cannot change
       the status any more -- so the break is repaired, not reported:
         * Before any header is sent, _acquire() primes the connection by
           reading the first data chunk. If that first chunk never arrives
           (immediate EOF while bytes are expected, or a stall), the client
           has not been answered yet, so we simply reconnect / refresh here.
         * After headers are sent, body_iterator() watches the byte count. On
           truncation, a read error, or a stall it closes the connection and
           re-opens it with a Range resuming at the byte already delivered,
           stitching the remaining bytes back into the SAME stream. The client
           sees one continuous, correctly-sized response and notices nothing.

    2. Live-but-stalled connection. The socket is open yet transfers no data
       (or only absurdly little) within a given window -- the curl -y/-Y case.
       Per-read asyncio timeouts catch pure silence (STALL_TIMEOUT), and a
       sliding-window rate check catches the "few bytes trickling" case
       (SPEED_LIMIT over SPEED_TIME; SPEED_LIMIT=0 disables rate checking).

    In BOTH cases we first retry the SAME upstream URL, because a stall or an
    early close is usually a transient CDN/network hiccup that a fresh
       connection to the same URL clears. Re-invoking yt-dlp for a new URL is
    only an escalation, used after the same-URL reconnect budget is spent, and
    is further capped by MAX_URL_REFRESHES to avoid pathological loops.

ENVIRONMENT VARIABLES
    YT_DLP_HTTPD_HOST           Bind address (default: 127.0.0.1)
    YT_DLP_HTTPD_PORT           Bind port (default: 8000)
    YT_DLP_HTTPD_RETRIES        Max same-URL reconnects for stream errors (default: 9)
    YT_DLP_HTTPD_RETRY_DELAY    Delay in seconds between reconnects (default: 10)
    YT_DLP_HTTPD_STALL_TIMEOUT  Max silence for one read / header fetch, in
                                seconds; 0 disables the silence timeout (default: 30)
    YT_DLP_HTTPD_SPEED_LIMIT    Min throughput in bytes/s before a stream is
                                considered stalled (curl -Y); 0 disables rate
                                checking (default: 0)
    YT_DLP_HTTPD_SPEED_TIME     Sliding window in seconds for the speed check
                                (curl -y) (default: 10)
    YT_DLP_HTTPD_MAX_REFRESH    Cap on yt-dlp URL refreshes per proxied request
                                in wrapper mode (default: 3)

REQUIREMENTS
    pip install starlette aiohttp uvicorn
"""

import sys
import os
import json
import time
import asyncio
import mimetypes
import logging
import html as html_module
from contextlib import asynccontextmanager

import aiohttp
import uvicorn
from starlette.applications import Starlette
from starlette.requests import Request
from starlette.responses import (
    Response,
    StreamingResponse,
    JSONResponse,
    HTMLResponse,
)
from starlette.routing import Route

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
)
logger = logging.getLogger("yt-dlp-httpd")

MAX_RETRIES = int(os.environ.get("YT_DLP_HTTPD_RETRIES", 9))
RETRY_DELAY = float(os.environ.get("YT_DLP_HTTPD_RETRY_DELAY", 10))
STALL_TIMEOUT = float(os.environ.get("YT_DLP_HTTPD_STALL_TIMEOUT", 30))
SPEED_LIMIT = int(os.environ.get("YT_DLP_HTTPD_SPEED_LIMIT", 0))
SPEED_TIME = float(os.environ.get("YT_DLP_HTTPD_SPEED_TIME", 10))
MAX_REFRESH = int(os.environ.get("YT_DLP_HTTPD_MAX_REFRESH", 3))
HOST = os.environ.get("YT_DLP_HTTPD_HOST", "127.0.0.1")
PORT = int(os.environ.get("YT_DLP_HTTPD_PORT", 8000))
CHUNK = 65536

routes = {}
ytdlp_args = []
is_wrapper_mode = False
_refresh_lock = asyncio.Lock()
_session = None  # shared, long-lived aiohttp session, created in lifespan


def format_size(size_bytes):
    """Human-readable file size."""
    if size_bytes is None:
        return "Unknown"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(size_bytes) < 1024.0:
            return f"{size_bytes:.1f} {unit}"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} PB"


def _read_timeout():
    """Per-read / per-connect ceiling derived from STALL_TIMEOUT. None means the
    caller awaits indefinitely (only used when STALL_TIMEOUT is disabled)."""
    return STALL_TIMEOUT if STALL_TIMEOUT and STALL_TIMEOUT > 0 else None


def process_entry(data):
    downloads = data.get("requested_downloads") or [data]
    for dl in downloads:
        fname = (
            dl.get("filename")
            or dl.get("_filename")
            or f"{data.get('id', 'video')}.{dl.get('ext', 'mp4')}"
        )
        path = "/" + fname.replace("\\", "/").lstrip("/")
        routes[path] = {
            "url": dl.get("url"),
            "headers": dl.get("http_headers", {}),
            "ext": dl.get("ext", "mp4"),
            "filesize": dl.get("filesize") or dl.get("filesize_approx"),
            "webpage_url": data.get("webpage_url"),
            "last_error": None,
        }
    logger.info(
        f"Loaded/Updated {len(downloads)} route(s) "
        f"from entry ID: {data.get('id', 'unknown')}"
    )


async def parse_jsonl_stream(reader):
    while True:
        line = await reader.readline()
        if not line:
            break
        try:
            process_entry(json.loads(line))
        except json.JSONDecodeError:
            continue


def parse_jsonl_sync(text):
    for line in text.splitlines():
        if not line.strip():
            continue
        try:
            process_entry(json.loads(line))
        except json.JSONDecodeError:
            continue


def parse_single_json(text):
    data = json.loads(text)
    entries = data.get("entries")
    if isinstance(entries, list):
        for entry in entries:
            if entry:
                process_entry(entry)
    else:
        process_entry(data)


async def invoke_ytdlp(args):
    cmd = ["yt-dlp"] + args
    has_dump = any(a in args for a in ["-j", "--dump-json", "-J", "--dump-single-json"])
    if not has_dump:
        cmd.append("--dump-json")
    if "--no-warnings" not in args:
        cmd.append("--no-warnings")

    logger.info(f"Invoking: {' '.join(cmd)}")
    use_single_json = "-J" in cmd or "--dump-single-json" in cmd

    proc = await asyncio.create_subprocess_exec(
        *cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=sys.stderr,
    )
    if use_single_json:
        stdout, _ = await proc.communicate()
        if stdout:
            parse_single_json(stdout.decode("utf-8"))
    else:
        await parse_jsonl_stream(proc.stdout)
    await proc.wait()
    if proc.returncode != 0 and not routes:
        logger.error(
            f"yt-dlp exited with code {proc.returncode} and no routes were loaded."
        )


async def _locked_refresh(path, before):
    """Serialize refreshes across concurrent requests for the same path.
    Double-check under the lock so only the first waiter re-invokes yt-dlp."""
    async with _refresh_lock:
        cur = routes.get(path, {}).get("url")
        if cur and cur != before:
            logger.info("Refresh already performed by a peer coroutine.")
            return
        logger.info("Acquired refresh lock, invoking yt-dlp...")
        await invoke_ytdlp(ytdlp_args)
        logger.info("Refresh complete, lock released.")


def _seg_expect(resp, status):
    """Bytes this response segment should deliver, or None if unknown (chunked)."""
    cr = resp.headers.get("Content-Range")
    if status == 206 and cr and "/" in cr:
        rng, _, total = cr.partition("/")
        span = rng.split("-")
        if len(span) == 2 and span[0].isdigit() and span[1].isdigit():
            return int(span[1]) - int(span[0]) + 1
    cl = resp.headers.get("Content-Length")
    if cl and cl.isdigit():
        return int(cl)
    return None


async def _request_with_timeout(method, url, headers):
    """session.request bounded by the stall timeout on connect + header receipt.
    Raises asyncio.TimeoutError if the server accepts nothing/headers too slowly."""
    to = _read_timeout()
    coro = _session.request(method, url, headers=headers, allow_redirects=True)
    if to:
        return await asyncio.wait_for(coro, timeout=to)
    return await coro


async def _read_first_chunk(resp, status):
    """Read the first data chunk from a live 200/206 response, honoring the stall
    timeout. Returns (chunk, reason) where reason in {'ok','eof','stall','error'}
    and chunk is the bytes read (may be b'' for eof). Errors release nothing; the
    caller closes the response."""
    expect = _seg_expect(resp, status)
    to = _read_timeout()
    try:
        if to:
            data = await asyncio.wait_for(resp.content.read(CHUNK), timeout=to)
        else:
            data = await resp.content.read(CHUNK)
    except asyncio.TimeoutError:
        return b"", "stall"
    except aiohttp.ClientPayloadError:
        # Content-Length not satisfied -> the connection was closed early.
        return b"", "eof"
    except aiohttp.ClientError:
        return b"", "error"
    if not data and (expect is None or expect > 0):
        return b"", "eof"
    return data, "ok"


async def _acquire(method, base_headers, path, abs_start, abs_end, is_head):
    """Obtain a HEALTHY upstream connection for the byte range beginning at
    abs_start. For GET this means a live response whose first data chunk has
    already been read (returned as ), so empty / stalled / early-closed
    replies are caught BEFORE the client is answered.

    Strategy: retry the SAME URL first (transient hiccups); only escalate to a
    yt-dlp refresh once the same-URL budget is spent.  is None for HEAD.

    Returns (resp, first). The caller owns resp (must close/release)."""
    range_val = f"bytes={abs_start}-" if abs_end is None else f"bytes={abs_start}-{abs_end}"
    reconnects = 0
    refreshes = 0

    while True:
        target = routes.get(path)
        if target is None:
            raise RuntimeError(f"Route vanished: {path}")
        url = target.get("url")
        if not url:
            raise RuntimeError(f"No upstream URL for {path}")

        headers = dict(base_headers)
        # A resume offset of 0 for a full GET means the client sent no Range;
        # only add an explicit Range when resuming mid-stream or when the
        # original request already carried one.
        if method == "GET" and (abs_start > 0 or "range" in base_headers):
            headers["range"] = range_val

        try:
            resp = await _request_with_timeout(method, url, headers)
        except (aiohttp.ClientError, asyncio.TimeoutError) as e:
            reason = "stalled header fetch" if isinstance(e, asyncio.TimeoutError) else f"network error: {e}"
            # cannot escalate via refresh from here reliably; reconnect same URL
            reconnects += 1
            if reconnects > MAX_RETRIES:
                logger.error(f"Acquire failed after {MAX_RETRIES} reconnects: {reason}")
                raise
            logger.warning(f"{reason}. Same-URL reconnect {reconnects}/{MAX_RETRIES} in {RETRY_DELAY}s...")
            await asyncio.sleep(RETRY_DELAY)
            continue

        status = resp.status
        target = routes[path]

        # EXPIRED-URL: escalate to refresh (this is the one case a new URL helps)
        if status in (401, 403, 410, 404) and is_wrapper_mode:
            if target.get("last_error") == status and refreshes >= MAX_REFRESH:
                logger.error(f"Continuous {status} for {path}; reporting it honestly.")
                return resp, None
            target["last_error"] = status
            before = target.get("url")
            await _locked_refresh(path, before)
            await resp.release()
            new_url = routes.get(path, {}).get("url")
            if new_url and new_url != before:
                refreshes += 1
                reconnects = 0
                logger.info(f"Refreshed URL (#{refreshes}); re-acquiring at byte {abs_start}.")
                continue
            # refresh produced nothing new; keep old status for honest report
            logger.error("Refresh did not yield a new URL; reporting upstream status.")
            return resp, None

        if status >= 400:
            # Non-retryable upstream error (e.g. real 416, 500): hand back as-is.
            return resp, None

        if is_head:
            if target.get("last_error") is not None:
                target["last_error"] = None
            # Sync size from the real HEAD response.
            cl = resp.headers.get("Content-Length")
            if cl and cl.isdigit() and int(cl) > 0 and int(cl) != target.get("filesize"):
                target["filesize"] = int(cl)
                logger.info(f"Size updated via HEAD for {path}: {format_size(int(cl))}")
            return resp, None

        # 200/206: prime the first chunk; catch empty / stall / early close here.
        first, why = await _read_first_chunk(resp, status)
        if why == "ok":
            if target.get("last_error") is not None:
                target["last_error"] = None
            return resp, first

        # first chunk failed -> connection is unusable, not yet answered to client
        await resp.release()
        logger.warning(f"Upstream {why} at byte {abs_start} (status {status}).")
        reconnects += 1
        if reconnects <= MAX_RETRIES:
            logger.info(f"Same-URL reconnect {reconnects}/{MAX_RETRIES} in {RETRY_DELAY}s...")
            await asyncio.sleep(RETRY_DELAY)
            continue
        # same-URL budget spent: escalate to refresh (wrapper mode only)
        if is_wrapper_mode and refreshes < MAX_REFRESH:
            before = routes.get(path, {}).get("url")
            await _locked_refresh(path, before)
            new_url = routes.get(path, {}).get("url")
            if new_url and new_url != before:
                refreshes += 1
                reconnects = 0
                logger.info(f"Escalated to URL refresh (#{refreshes}); re-acquiring at byte {abs_start}.")
                continue
        # Nothing more we can do without answering a broken stream: return a
        # freshly-opened response so the handler at least has a valid status to
        # mirror to the client (it will end up looking like an early EOF, which
        # clients can retry themselves).
        logger.error(
            f"Could not obtain a healthy upstream segment at byte {abs_start} "
            f"for {path} after {reconnects} reconnects / {refreshes} refreshes."
        )
        return await _request_with_timeout(method, url, base_headers), None


async def body_iterator(resp, first, base_headers, path, abs_start, abs_end,
                        seg_expect, seg_got):
    """Stream bytes to the client, transparently resuming on stall / truncation.
    Runs against the shared session, so it is safe after the handler returns.
    Never writes any file. / are absolute byte offsets of the
    logical response the client is receiving; / describe the
    current upstream segment.  is the already-read primed chunk (or None)."""
    delivered = seg_got  # bytes yielded within the current logical response
    total = abs_end - abs_start + 1 if abs_end is not None else None
    reconnects = 0
    refreshes = 0

    # window for speed-limit (curl -Y) checking
    win_start = time.monotonic()
    win_bytes = 0

    while True:
        cur = resp
        first_local = first
        first = None
        try:
            if first_local is not None:
                if not first_local and total is not None and delivered < total:
                    raise _Truncated()
                if first_local:
                    yield first_local
                    delivered += len(first_local)
                    win_bytes += len(first_local)
                    seg_got += len(first_local)

            while True:
                # remaining bytes for the whole logical response
                if total is not None and delivered >= total:
                    return
                to = _read_timeout()
                try:
                    if to:
                        chunk = await asyncio.wait_for(cur.content.read(CHUNK), timeout=to)
                    else:
                        chunk = await cur.content.read(CHUNK)
                except asyncio.TimeoutError:
                    raise _Stalled()
                except aiohttp.ClientPayloadError:
                    raise _Truncated()
                except aiohttp.ClientError as e:
                    raise _Broken(str(e))

                if not chunk:
                    if cur.status == 206 or cur.status == 200:
                        if seg_expect is None:
                            return  # chunked / unknown length: EOF is normal
                        if seg_got < seg_expect:
                            raise _Truncated()
                    return

                yield chunk
                delivered += len(chunk)
                seg_got += len(chunk)
                win_bytes += len(chunk)

                if SPEED_LIMIT > 0:
                    elapsed = time.monotonic() - win_start
                    if elapsed >= SPEED_TIME:
                        rate = win_bytes / elapsed if elapsed else 0
                        if rate < SPEED_LIMIT:
                            raise _Stalled(f"rate {rate:.0f} B/s < {SPEED_LIMIT}")
                        win_start = time.monotonic()
                        win_bytes = 0
            return
        except (_Truncated, _Stalled, _Broken) as why:
            cur.close()
            reason = why.args[0] if why.args and isinstance(why.args[0], str) else type(why).__name__
            logger.warning(f"Stream broke at byte {delivered} ({reason}); attempting resume.")

            # cannot resume if we have nothing to resume from and no total known
            if total is None and delivered == 0:
                logger.error("Empty reply with unknown length; nothing to resume.")
                return

            if delivered and (total is None or delivered < total):
                new_abs_start = abs_start + delivered
                try:
                    resp, first = await _acquire(
                        "GET", base_headers, path, new_abs_start, abs_end, False
                    )
                except (aiohttp.ClientError, asyncio.TimeoutError, RuntimeError) as e:
                    logger.error(f"Resume acquire failed: {e}; ending stream.")
                    return
                status = resp.status
                if status == 206:
                    # recompute segment expectation from the resumed response
                    seg_expect = _seg_expect(resp, status)
                    seg_got = 0
                    reconnects += 1
                    logger.info(f"Resumed at byte {delivered} (segment reconnect {reconnects}).")
                    continue
                if status == 200 and delivered == 0:
                    # upstream ignored Range but we are at the very start: fine
                    seg_expect = _seg_expect(resp, status)
                    seg_got = 0
                    reconnects += 1
                    continue
                # upstream did not honour the resume range -> we cannot stitch
                # transparently without corrupting the byte stream.
                logger.error(
                    f"Upstream returned {status} on resume (Range not honored); "
                    f"cannot continue without corrupting the stream. Aborting body."
                )
                resp.close()
                return
            else:
                # delivered == total (or nothing delivered): treat as done
                return
        except GeneratorExit:
            cur.close()
            raise
        finally:
            # close whatever we are holding when the loop truly exits
            try:
                cur.close()
            except Exception:
                pass


class _Truncated(Exception):
    pass


class _Stalled(Exception):
    pass


class _Broken(Exception):
    pass


async def directory_listing(request: Request):
    rows = []
    for path in sorted(routes.keys()):
        target = routes[path]
        safe_path = html_module.escape(path)
        safe_name = html_module.escape(os.path.basename(path))
        size_str = format_size(target.get("filesize"))
        mime_type, _ = mimetypes.guess_type(f"file.{target.get('ext', 'mp4')}")
        mime_str = html_module.escape(mime_type or "application/octet-stream")
        webpage = target.get("webpage_url", "")
        source_link = ""
        if webpage:
            source_link = (
                f'<a href="{html_module.escape(webpage)}" '
                f'target="_blank" rel="noopener">source</a>'
            )
        rows.append(
            f'<tr><td><a href="{safe_path}">{safe_name}</a></td>'
            f'<td style="text-align:right">{size_str}</td>'
            f"<td>{mime_str}</td><td>{source_link}</td></tr>"
        )
    html_content = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>yt-dlp-httpd Stream Directory</title>
<style>
  body {{ font-family: monospace; margin: 2em; background: #1a1a2e; color: #e0e0e0; }}
  h1 {{ color: #00d4ff; }}
  table {{ border-collapse: collapse; width: 100%; }}
  th, td {{ padding: 8px 12px; text-align: left; border-bottom: 1px solid #333; }}
  th {{ background: #16213e; color: #00d4ff; position: sticky; top: 0; }}
  tr:hover {{ background: #16213e; }}
  a {{ color: #4fc3f7; text-decoration: none; }}
  a:hover {{ text-decoration: underline; }}
  .count {{ color: #888; font-size: 0.9em; }}
</style>
</head>
<body>
<h1>yt-dlp-httpd Stream Directory</h1>
<p class="count">{len(routes)} stream(s) available &middot; Sizes are updated live from real upstream responses.</p>
<table>
<thead><tr><th>Filename</th><th style="text-align:right">Size</th><th>MIME Type</th><th>Source</th></tr></thead>
<tbody>{"".join(rows)}</tbody>
</table>
</body>
</html>"""
    return HTMLResponse(html_content)


def _parse_range(range_header, filesize):
    """Return (abs_start, abs_end_or_None) for a single-range request."""
    if not range_header or not range_header.startswith("bytes="):
        return 0, None
    spec = range_header[len("bytes="):].split(",")[0].strip()
    if "-" not in spec:
        return 0, None
    start_s, _, end_s = spec.partition("-")
    start = int(start_s) if start_s.isdigit() else 0
    if end_s.isdigit():
        end = int(end_s)
    elif filesize:
        end = filesize - 1
    else:
        end = None
    return start, end


async def proxy_handler(request: Request):
    path = request.url.path

    if path in ("/", ""):
        return await directory_listing(request)

    if path not in routes:
        return JSONResponse(
            {"detail": "Stream not found in routing table"}, status_code=404
        )

    target = routes[path]

    # build upstream headers (yt-dlp headers take precedence)
    upstream_headers = {}
    for key in ["user-agent", "accept", "accept-language", "range"]:
        if key in request.headers:
            upstream_headers[key] = request.headers[key]
    # accept-encoding is intentionally NOT forwarded so streamed bytes match CL.
    for k, v in target["headers"].items():
        upstream_headers[k.lower()] = str(v)

    mime_type, _ = mimetypes.guess_type(f"file.{target['ext']}")
    if not mime_type:
        mime_type = "application/octet-stream"

    is_head = request.method == "HEAD"
    abs_start, abs_end = _parse_range(
        upstream_headers.get("range"), routes[path].get("filesize")
    )

    try:
        resp, first = await _acquire(
            request.method, upstream_headers, path, abs_start, abs_end, is_head
        )
    except (aiohttp.ClientError, asyncio.TimeoutError, RuntimeError) as e:
        logger.error(f"Upstream open failed for {path}: {e}")
        return JSONResponse({"detail": f"Upstream error: {e}"}, status_code=502)

    status_code = resp.status
    content_range = resp.headers.get("Content-Range")

    if is_head:
        out_headers = {"Content-Type": mime_type, "Accept-Ranges": "bytes"}
        if content_range:
            out_headers["Content-Range"] = content_range
        cl = resp.headers.get("Content-Length")
        if cl and cl.isdigit():
            out_headers["Content-Length"] = cl
        elif routes[path].get("filesize"):
            out_headers["Content-Length"] = str(routes[path]["filesize"])
        await resp.release()
        return Response(
            content=b"", status_code=status_code, headers=out_headers,
            media_type=mime_type,
        )

    out_headers = {"Content-Type": mime_type, "Accept-Ranges": "bytes"}
    if status_code == 206 and content_range:
        out_headers["Content-Range"] = content_range
        partial_len = content_range.rsplit("/", 1)[-1]
        if partial_len.isdigit():
            out_headers["Content-Length"] = partial_len
    elif status_code == 416:
        if content_range:
            out_headers["Content-Range"] = content_range
    else:
        cl = resp.headers.get("Content-Length")
        if cl and cl.isdigit():
            out_headers["Content-Length"] = cl
        elif routes[path].get("filesize"):
            out_headers["Content-Length"] = str(routes[path]["filesize"])

    # HEAD: headers only, release the connection, no streaming generator
    if status_code >= 400:
        # error page: stream it out plainly, no resume logic
        return StreamingResponse(
            body_iterator(resp, first, upstream_headers, path,
                          abs_start, abs_end, _seg_expect(resp, status_code), 0),
            status_code=status_code, headers=out_headers, media_type=mime_type,
        )

    seg_expect = _seg_expect(resp, status_code)
    return StreamingResponse(
        body_iterator(resp, first, upstream_headers, path,
                      abs_start, abs_end, seg_expect,
                      len(first) if first else 0),
        status_code=status_code, headers=out_headers, media_type=mime_type,
    )


@asynccontextmanager
async def lifespan(app):
    global _session
    # sock_read left None at the session level; per-read stall timeouts are
    # applied explicitly in _acquire / body_iterator so a live-but-idle
    # connection is detected instead of hanging forever.
    timeout = aiohttp.ClientTimeout(total=None, sock_connect=30, sock_read=None)
    connector = aiohttp.TCPConnector(limit=0, ttl_dns_cache=300)
    # Shared, long-lived session: survives past the handler return so streaming
    # bodies always execute against a live session.
    _session = aiohttp.ClientSession(timeout=timeout, connector=connector)
    try:
        if is_wrapper_mode:
            await invoke_ytdlp(ytdlp_args)
        yield
    finally:
        await _session.close()
        _session = None


app = Starlette(
    routes=[Route("/{path:path}", proxy_handler, methods=["GET", "HEAD"])],
    lifespan=lifespan,
)


if __name__ == "__main__":
    basename = os.path.basename(sys.argv[0])
    if basename == "yt-dlp-httpd" or (
        len(sys.argv) > 1 and sys.argv[1] == "--wrapper-mode"
    ):
        is_wrapper_mode = True
        ytdlp_args = sys.argv[1:] if basename == "yt-dlp-httpd" else sys.argv[2:]
        logger.info("Starting in Wrapper Mode...")
    else:
        if len(sys.argv) < 2:
            print(__doc__)
            sys.exit(1)
        source = sys.argv[1]
        logger.info(f"Starting in Default Mode. Reading from: {source}")
        if source == "-":
            parse_jsonl_sync(sys.stdin.read())
        else:
            with open(source, "r", encoding="utf-8") as f:
                content = f.read()
            try:
                parse_single_json(content)
            except json.JSONDecodeError:
                parse_jsonl_sync(content)

    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
