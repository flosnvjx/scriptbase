logger = logging.getLogger("yt-dlp-httpd")

MAX_RETRIES = int(os.environ.get("YT_DLP_HTTPD_RETRIES", 9))
RETRY_DELAY = float(os.environ.get("YT_DLP_HTTPD_RETRY_DELAY", 10))
STALL_TIMEOUT = float(os.environ.get("YT_DLP_HTTPD_STALL_TIMEOUT", 30))
SPEED_LIMIT = int(os.environ.get("YT_DLP_HTTPD_SPEED_LIMIT", 0))
SPEED_TIME = float(os.environ.get("YT_DLP_HTTPD_SPEED_TIME", 10))
