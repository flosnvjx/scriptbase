def _parse_range(range_header, filesize):
    """Return (abs_start, abs_end_or_None) for a single-range request."""
    if not range_header or not range_header.startswith("bytes="):
        return 0, None
    spec = range_header[len("bytes="):].split(",")[0].strip()
    if "-" not in spec:
        return 0, None
    start_s, _, end_s = spec.partition("-")
    start = int(start_s) if start_s.isdigit() else 0
    if end_s.isdigit():
        end = int(end_s)
    elif filesize:
        end = filesize - 1
    else:
        end = None
    return start, end


async def proxy_handler(request: Request):
    path = request.url.path

    if path in ("/", ""):
        return await directory_listing(request)

    if path not in routes:
        return JSONResponse(
            {"detail": "Stream not found in routing table"}, status_code=404
        )

    target = routes[path]

    # build upstream headers (yt-dlp headers take precedence)
    upstream_headers = {}
    for key in ["user-agent", "accept", "accept-language", "range"]:
        if key in request.headers:
            upstream_headers[key] = request.headers[key]
    # accept-encoding is intentionally NOT forwarded so streamed bytes match CL.
    for k, v in target["headers"].items():
        upstream_headers[k.lower()] = str(v)

    mime_type, _ = mimetypes.guess_type(f"file.{target['ext']}")
    if not mime_type:
        mime_type = "application/octet-stream"

    is_head = request.method == "HEAD"
    abs_start, abs_end = _parse_range(
        upstream_headers.get("range"), routes[path].get("filesize")
    )

    try:
        resp, first = await _acquire(
            request.method, upstream_headers, path, abs_start, abs_end, is_head
        )
    except (aiohttp.ClientError, asyncio.TimeoutError, RuntimeError) as e:
        logger.error(f"Upstream open failed for {path}: {e}")
        return JSONResponse({"detail": f"Upstream error: {e}"}, status_code=502)

    status_code = resp.status
    content_range = resp.headers.get("Content-Range")

    if is_head:
        out_headers = {"Content-Type": mime_type, "Accept-Ranges": "bytes"}
        out_headers["Content-Disposition"] = _content_disposition(target.get("download_name"))
        if content_range:
            out_headers["Content-Range"] = content_range
        cl = resp.headers.get("Content-Length")
        if cl and cl.isdigit():
            out_headers["Content-Length"] = cl
        elif routes[path].get("filesize"):
            out_headers["Content-Length"] = str(routes[path]["filesize"])
        await resp.release()
        return Response(
            content=b"", status_code=status_code, headers=out_headers,
            media_type=mime_type,
        )

    out_headers = {"Content-Type": mime_type, "Accept-Ranges": "bytes"}
    out_headers["Content-Disposition"] = _content_disposition(target.get("download_name"))
    if status_code == 206:
        if content_range:
            out_headers["Content-Range"] = content_range
        # Content-Length is the size of THIS segment, not the whole file.
        seg_len = _seg_expect(resp, status_code)
        if seg_len is None and abs_end is not None:
            seg_len = abs_end - abs_start + 1
        if seg_len is not None:
            out_headers["Content-Length"] = str(seg_len)
    elif status_code == 416:
        if content_range:
            out_headers["Content-Range"] = content_range
    else:
        cl = resp.headers.get("Content-Length")
        if cl and cl.isdigit():
            out_headers["Content-Length"] = cl
        elif routes[path].get("filesize"):
            out_headers["Content-Length"] = str(routes[path]["filesize"])

    # HEAD: headers only, release the connection, no streaming generator
    if status_code >= 400:
        # error page: stream it out plainly, no resume logic
        return StreamingResponse(
            body_iterator(resp, first, upstream_headers, path,
                          abs_start, abs_end, _seg_expect(resp, status_code), 0),
            status_code=status_code, headers=out_headers, media_type=mime_type,
        )

    seg_expect = _seg_expect(resp, status_code)
    return StreamingResponse(
        body_iterator(resp, first, upstream_headers, path,
                      abs_start, abs_end, seg_expect,
                      len(first) if first else 0),
        status_code=status_code, headers=out_headers, media_type=mime_type,
    )


@asynccontextmanager
async def lifespan(app):
    global _session
    # sock_read left None at the session level; per-read stall timeouts are
    # applied explicitly in _acquire / body_iterator so a live-but-idle
    # connection is detected instead of hanging forever.
    timeout = aiohttp.ClientTimeout(total=None, sock_connect=30, sock_read=None)
    connector = aiohttp.TCPConnector(limit=0, ttl_dns_cache=300)
    # Shared, long-lived session: survives past the handler return so streaming
    # bodies always execute against a live session.
    _session = aiohttp.ClientSession(timeout=timeout, connector=connector)
    try:
        if is_wrapper_mode:
            await invoke_ytdlp(ytdlp_args)
        yield
    finally:
        await _session.close()
        _session = None


app = Starlette(
    routes=[Route("/{path:path}", proxy_handler, methods=["GET", "HEAD"])],
    lifespan=lifespan,
)


if __name__ == "__main__":
    basename = os.path.basename(sys.argv[0])
    if basename == "yt-dlp-httpd" or (
        len(sys.argv) > 1 and sys.argv[1] == "--wrapper-mode"
    ):
        is_wrapper_mode = True
        ytdlp_args = sys.argv[1:] if basename == "yt-dlp-httpd" else sys.argv[2:]
        logger.info("Starting in Wrapper Mode...")
    else:
        if len(sys.argv) < 2:
            print(__doc__)
            sys.exit(1)
        source = sys.argv[1]
        logger.info(f"Starting in Default Mode. Reading from: {source}")
        if source == "-":
            parse_jsonl_sync(sys.stdin.read())
        else:
            with open(source, "r", encoding="utf-8") as f:
                content = f.read()
            try:
                parse_single_json(content)
            except json.JSONDecodeError:
                parse_jsonl_sync(content)

    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
