#!/usr/bin/env shorthandzsh
# Enable extended globbing locally
setopt localoptions extendedglob

# Read all input until EOF
local input
input="$(cat)"

# Split into lines (handle possible CRLF)
local lines line
lines=("${(@f)input}")

# Collect lines matching the required pattern
local matched_lines=()
for line in $lines; do
  line=${line%$'\r'}                     # strip trailing CR
  if [[ $line = (#b)idman\ /d\ \"([^\"]##)\"\ /p\ \"[^\"]##\"\ /f\ \"([^\"]##)\"[ ]# ]]; then
    matched_lines+=("${line%% #}")
  fi
done

# Abort if nothing matched
if (( ${#matched_lines} == 0 )); then
  print -u2 "No matching line found."
  return 1
fi

# Choose a line (auto-select if only one)
local selected_full
if (( ${#matched_lines} == 1 )); then
  selected_full=$matched_lines[1]
else
  # Build fzf input: each line is "full_line<TAB>filename"
  local display_lines=()
  local full_line fname
  for full_line in $matched_lines; do
    if [[ $full_line = (#b)idman\ /d\ \"([^\"]##)\"\ /p\ \"[^\"]##\"\ /f\ \"([^\"]##)\" ]]; then
      fname=$match[2]
    else
      fname="???" # shouldn't happen
    fi
    display_lines+=("${full_line}"$'\t'"${fname}")
  done

  local chosen
  chosen=$(print -l -- $display_lines | fzf --prompt="Select file: " --delimiter=$'\t' --with-nth=2 --no-multi)
  if [[ -z $chosen ]]; then
    print -u2 "No selection made."
    return 1
  fi
  # Extract full line (everything before the first TAB)
  selected_full=${chosen%%$'\t'*}
fi

# Extract URL and filename from the selected full line
local url fn
if [[ $selected_full = (#b)idman\ /d\ \"([^\"]##)\"\ /p\ \"[^\"]##\"\ /f\ \"([^\"]##)\" ]]; then
  url=$match[1]
  fn=$match[2]
else
  print -u2 "Selected line unexpectedly does not match pattern."
  return 1
fi

if [[ -z $fn || -z $url ]]; then
  print -u2 "Failed to extract filename or URL from the selected line."
  return 1
fi

# Run the resumable download loop
while [[ -v commands[curl] && -v fn && -v url ]]; do
  if curl -qgsfLC "$(stat -c %s -- "$fn")" --url "$url" -w "%{stderr}$fn\n" --retry 0 -y185 -Y10240 >> "$fn"; then
    :
  else
    if [[ $? != (6|52|35|18|56|28) ]]; then
      sleep 10
    else
      return 1
    fi
  fi
done
