#!/usr/bin/env python3
"""
LessPass Minimal CLI - Password Derivation Only
Single-file, no external dependencies, no sync/config features.
"""

import argparse
import getpass
import hashlib
import hmac
import math
import string
import sys


# Default derivation parameters matching upstream LessPass
DEFAULT_LENGTH = 16
DEFAULT_COUNTER = 1
DEFAULT_ITERATIONS = 100000
CHARSETS = {
    "lowercase": string.ascii_lowercase,
    "uppercase": string.ascii_uppercase,
    "digits": string.digits,
    "symbols": "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
}


def normalize_site(site: str) -> str:
    """Normalize site input to match upstream LessPass behavior."""
    site = site.strip()
    for prefix in ("https://", "http://"):
        if site.lower().startswith(prefix):
            site = site[len(prefix):]
    site = site.split("/")[0]
    site = site.split(":")[0]
    return site.lower()


def derive_password(
    site: str,
    login: str,
    master_password: str,
    length: int = DEFAULT_LENGTH,
    counter: int = DEFAULT_COUNTER,
    use_lowercase: bool = True,
    use_uppercase: bool = True,
    use_digits: bool = True,
    use_symbols: bool = True,
) -> str:
    """Core LessPass password derivation algorithm."""
    charset = ""
    if use_lowercase:
        charset += CHARSETS["lowercase"]
    if use_uppercase:
        charset += CHARSETS["uppercase"]
    if use_digits:
        charset += CHARSETS["digits"]
    if use_symbols:
        charset += CHARSETS["symbols"]

    if not charset:
        raise ValueError("At least one character set must be enabled")

    normalized_site = normalize_site(site)
    salt = f"{normalized_site}{login}{counter}"

    # Step 1: PBKDF2-HMAC-SHA256 to derive intermediate key
    dk = hashlib.pbkdf2_hmac(
        "sha256",
        master_password.encode("utf-8"),
        salt.encode("utf-8"),
        DEFAULT_ITERATIONS,
        dklen=32,
    )

    # Step 2: HMAC-SHA256 to generate password entropy
    entropy = hmac.new(dk, salt.encode("utf-8"), hashlib.sha256).digest()

    # Step 3: Map entropy bytes to charset
    password_chars = []
    charset_len = len(charset)
    max_byte = 255
    # Rejection sampling to avoid modulo bias
    threshold = (max_byte + 1) - ((max_byte + 1) % charset_len)

    idx = 0
    while len(password_chars) < length:
        byte_val = entropy[idx % len(entropy)]
        idx += 1
        if byte_val < threshold:
            password_chars.append(charset[byte_val % charset_len])
        # If we exhaust entropy bytes before reaching desired length,
        # re-derive with extended salt (upstream compatible fallback)
        if idx >= len(entropy) and len(password_chars) < length:
            ext_salt = f"{salt}{len(password_chars)}"
            entropy = hmac.new(dk, ext_salt.encode("utf-8"), hashlib.sha256).digest()
            idx = 0

    return "".join(password_chars[:length])


def read_master_password_from_file(filepath: str) -> str:
    """Read master password from file or named pipe, stripping trailing newline."""
    try:
        with open(filepath, "r") as f:
            content = f.read()
        # Strip only trailing newlines (preserve leading/trailing spaces intentionally)
        return content.rstrip("\n").rstrip("\r")
    except FileNotFoundError:
        print(f"Error: File not found: {filepath}", file=sys.stderr)
        sys.exit(1)
    except PermissionError:
        print(f"Error: Permission denied: {filepath}", file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        print(f"Error reading {filepath}: {e}", file=sys.stderr)
        sys.exit(1)


def prompt_params(args, master_password_from_file: str | None) -> dict:
    """Interactively prompt for missing or --ask forced parameters.
    Errors cleanly when stdin is not a tty and required params are missing.
    """
    params = {}
    is_tty = sys.stdin.isatty()

    # Site (always required)
    if args.ask or not args.site:
        if not is_tty:
            print("Error: 'site' is required but stdin is not a terminal. "
                  "Provide it as a positional argument.", file=sys.stderr)
            sys.exit(1)
        params["site"] = input("Site: ").strip()
        if not params["site"]:
            print("Error: Site cannot be empty", file=sys.stderr)
            sys.exit(1)
    else:
        params["site"] = args.site

    # Login (required for derivation)
    if args.ask or not args.login:
        if not is_tty:
            print("Error: 'login' is required but stdin is not a terminal. "
                  "Provide it as a positional argument.", file=sys.stderr)
            sys.exit(1)
        params["login"] = input("Login: ").strip()
    else:
        params["login"] = args.login

    # Master password (required; may come from -F, positional, or prompt)
    if args.ask:
        if not is_tty:
            print("Error: --ask requires an interactive terminal for master password input.",
                  file=sys.stderr)
            sys.exit(1)
        params["master_password"] = getpass.getpass("Master password: ")
    elif master_password_from_file is not None:
        params["master_password"] = master_password_from_file
    elif args.master_password:
        params["master_password"] = args.master_password
    else:
        if not is_tty:
            print("Error: Master password is required but stdin is not a terminal. "
                  "Provide it via positional arg, -F FILE, or run interactively.",
                  file=sys.stderr)
            sys.exit(1)
        params["master_password"] = getpass.getpass("Master password: ")

    if not params["master_password"]:
        print("Error: Master password cannot be empty", file=sys.stderr)
        sys.exit(1)

    return params


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="LessPass Minimal CLI - Stateless password derivation only",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("site", nargs="?", default=None, help="Site/domain (optional, prompted if omitted)")
    parser.add_argument("login", nargs="?", default=None, help="Login/username (optional, prompted if omitted)")
    parser.add_argument("master_password", nargs="?", default=None, help="Master password (optional, prompted if omitted)")
    parser.add_argument("-F", "--file", dest="password_file", default=None,
                        help="Read master password from file or named pipe")
    parser.add_argument("--ask", action="store_true",
                        help="Force interactive prompt for all params even if specified")
    parser.add_argument("-l", "--length", type=int, default=DEFAULT_LENGTH,
                        help=f"Password length (default: {DEFAULT_LENGTH})")
    parser.add_argument("-c", "--counter", type=int, default=DEFAULT_COUNTER,
                        help=f"Counter value (default: {DEFAULT_COUNTER})")
    parser.add_argument("--no-lowercase", action="store_true", help="Exclude lowercase letters")
    parser.add_argument("--no-uppercase", action="store_true", help="Exclude uppercase letters")
    parser.add_argument("--no-digits", action="store_true", help="Exclude digits")
    parser.add_argument("--no-symbols", action="store_true", help="Exclude symbols")
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    # Read master password from file if -F specified (before prompting)
    master_password_from_file = None
    if args.password_file and not args.ask:
        master_password_from_file = read_master_password_from_file(args.password_file)

    # Resolve parameters (interactive if needed)
    params = prompt_params(args, master_password_from_file)

    try:
        password = derive_password(
            site=params["site"],
            login=params["login"],
            master_password=params["master_password"],
            length=args.length,
            counter=args.counter,
            use_lowercase=not args.no_lowercase,
            use_uppercase=not args.no_uppercase,
            use_digits=not args.no_digits,
            use_symbols=not args.no_symbols,
        )
        print(password)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        sys.exit(130)


if __name__ == "__main__":
    main()
