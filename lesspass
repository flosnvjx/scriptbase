#!/usr/bin/env python3
"""
Single-file LessPass CLI (password derivation only).

Usage:
  lesspass SITE LOGIN MASTER_PASSWORD [OPTIONS]
  lesspass SITE LOGIN -F MASTER_PASSWORD_FILE [OPTIONS]
  echo "mypass" | lesspass SITE LOGIN -F - [OPTIONS]
  lesspass --ask [OPTIONS]

SITE, LOGIN, MASTER_PASSWORD must be supplied on the command line, resolved
from a file via -F, or entered interactively.  Missing values are prompted
for when stdin is a TTY; otherwise an error is reported.  --ask forces
interactive editing of all three even when they are already supplied.
"""

import argparse
import hashlib
import os
import sys

__version__ = "10.2.1"

# termios/tty are POSIX-only; on Windows we use msvcrt instead.
try:
    import termios
    import tty
    _HAVE_TERMIOS = True
except ImportError:
    _HAVE_TERMIOS = False


# ---------------------------------------------------------------------------
# Password derivation core (from LessPass)
# ---------------------------------------------------------------------------

CHARACTER_SUBSETS = {
    "lowercase": "abcdefghijklmnopqrstuvwxyz",
    "uppercase": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "digits": "0123456789",
    "symbols": "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
}


class ExcludeAllCharsAvailable(Exception):
    pass


def _calc_entropy(password_profile, master_password):
    salt = (
        password_profile["site"]
        + password_profile["login"]
        + hex(password_profile["counter"])[2:]
    )
    hex_entropy = hashlib.pbkdf2_hmac(
        "sha256",
        master_password.encode("utf-8"),
        salt.encode("utf-8"),
        100000,
        32,
    ).hex()
    return int(hex_entropy, 16)


def _remove_excluded_chars(string, exclude):
    new_string = "".join(c for c in string if c not in exclude)
    if len(new_string) == 0:
        raise ExcludeAllCharsAvailable
    return new_string


def _get_set_of_characters(rules=None, exclude=""):
    if rules is None:
        return (
            CHARACTER_SUBSETS["lowercase"]
            + CHARACTER_SUBSETS["uppercase"]
            + CHARACTER_SUBSETS["digits"]
            + CHARACTER_SUBSETS["symbols"]
        )
    pool_of_chars = ""
    for rule in rules:
        pool_of_chars += CHARACTER_SUBSETS[rule]
    return _remove_excluded_chars(pool_of_chars, exclude)


def _consume_entropy(generated_password, quotient, set_of_characters, max_length):
    if len(generated_password) >= max_length:
        return [generated_password, quotient]
    quotient, remainder = divmod(quotient, len(set_of_characters))
    generated_password += set_of_characters[remainder]
    return _consume_entropy(generated_password, quotient, set_of_characters, max_length)


def _insert_string_pseudo_randomly(generated_password, entropy, string):
    for letter in string:
        quotient, remainder = divmod(entropy, len(generated_password))
        generated_password = (
            generated_password[:remainder] + letter + generated_password[remainder:]
        )
        entropy = quotient
    return generated_password


def _get_one_char_per_rule(entropy, rules, exclude=""):
    one_char_per_rules = ""
    for rule in rules:
        available_chars = _remove_excluded_chars(CHARACTER_SUBSETS[rule], exclude)
        value, entropy = _consume_entropy("", entropy, available_chars, 1)
        one_char_per_rules += value
    return [one_char_per_rules, entropy]


def _get_configured_rules(password_profile):
    rules = ["lowercase", "uppercase", "digits", "symbols"]
    return [rule for rule in rules if password_profile.get(rule)]


def _render_password(entropy, password_profile):
    rules = _get_configured_rules(password_profile)
    excluded_chars = password_profile.get("exclude", "")
    set_of_characters = _get_set_of_characters(rules, excluded_chars)
    password, password_entropy = _consume_entropy(
        "", entropy, set_of_characters, password_profile["length"] - len(rules)
    )
    characters_to_add, character_entropy = _get_one_char_per_rule(
        password_entropy, rules, excluded_chars
    )
    return _insert_string_pseudo_randomly(
        password, character_entropy, characters_to_add
    )


def generate_password(password_profile, master_password):
    entropy = _calc_entropy(password_profile, master_password)
    return _render_password(entropy, password_profile)


# ---------------------------------------------------------------------------
# Terminal I/O helpers
#
# All interactive prompts (and the '*' masked echo) go to stderr so that
# stdout carries only the generated password.
# ---------------------------------------------------------------------------

def _read_line_from_stdin():
    line = sys.stdin.readline()
    if not line:
        return None
    if line.endswith("\n"):
        line = line[:-1]
    return line


def _read_line_with_prompt(prompt):
    """Read a line from stdin, writing the prompt to stderr.

    Used when stdin is not a TTY.  The terminal (or pipe) is left to
    handle any echoed newline; we do not append one.
    """
    sys.stderr.write(prompt)
    sys.stderr.flush()
    return _read_line_from_stdin()


def _read_password_raw(prompt, echo_star):
    """Read a line from the TTY with echo suppressed; optionally echo '*'."""
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    sys.stderr.write(prompt)
    sys.stderr.flush()
    chars = []
    try:
        tty.setraw(fd)
        while True:
            ch = sys.stdin.read(1)
            if ch == "":
                # Actual EOF (terminal closed / input exhausted)
                break
            if ch in ("\r", "\n"):
                break
            if ch == "\x03":  # Ctrl+C
                raise KeyboardInterrupt
            if ch == "\x04":  # Ctrl+D
                if not chars:
                    raise EOFError
                continue
            if ch in ("\x7f", "\b"):  # backspace
                if chars:
                    chars.pop()
                    if echo_star:
                        sys.stderr.write("\b \b")
                        sys.stderr.flush()
                continue
            chars.append(ch)
            if echo_star:
                sys.stderr.write("*")
                sys.stderr.flush()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    sys.stderr.write("\n")
    sys.stderr.flush()
    return "".join(chars)


def _read_password_raw_windows(prompt, echo_star):
    import msvcrt

    sys.stderr.write(prompt)
    sys.stderr.flush()
    chars = []
    while True:
        ch = msvcrt.getwch()
        if ch in ("\r", "\n"):
            break
        if ch == "\x03":  # Ctrl+C
            raise KeyboardInterrupt
        if ch == "\x04":  # Ctrl+D
            if not chars:
                raise EOFError
            continue
        if ch == "\b":
            if chars:
                chars.pop()
                if echo_star:
                    sys.stderr.write("\b \b")
                    sys.stderr.flush()
            continue
        chars.append(ch)
        if echo_star:
            sys.stderr.write("*")
            sys.stderr.flush()
    sys.stderr.write("\n")
    sys.stderr.flush()
    return "".join(chars)


def _read_secret(prompt, mask):
    """Read a secret from stdin.  Masked by default; no-echo when mask is False."""
    if not sys.stdin.isatty():
        return _read_line_with_prompt(prompt)

    if _HAVE_TERMIOS:
        return _read_password_raw(prompt, echo_star=mask)
    if os.name == "nt":
        return _read_password_raw_windows(prompt, echo_star=mask)

    # No terminal control available on this platform; degrade to a plain
    # read with a warning so the user knows the password will be visible.
    sys.stderr.write(
        "warning: cannot disable terminal echo; password will echo\n"
    )
    sys.stderr.flush()
    return _read_line_with_prompt(prompt)


# ---------------------------------------------------------------------------
# CLI helpers
# ---------------------------------------------------------------------------

HELP_TEXT = """\
LessPass {version} - stateless password generator

Usage:
  lesspass [SITE] [LOGIN] [MASTER_PASSWORD] [OPTIONS]

Options:
  -v, --version          Show version and exit
  -h, --help             Show this help and exit
  -F, --file FILE        Read master password from FILE ('-' for stdin)
      --ask              Interactively edit all three parameters
      --no-mask          Don't echo '*' while typing master password
                         (alias: --no-fingerprint)
  -L, --length N         Password length (default: 16, min: 5, max: 35)
  -C, --counter N        Password counter (default: 1)
      --exclude CHARS    Exclude these characters from generated password
  -l, --lowercase        Add lowercase to password
  -u, --uppercase        Add uppercase to password
  -d, --digits           Add digits to password
  -s, --symbols          Add symbols to password
      --no-lowercase     Remove lowercase from password
      --no-uppercase     Remove uppercase from password
      --no-digits        Remove digits from password
      --no-symbols       Remove symbols from password

Notes:
  On platforms lacking reliable terminal control, the master password
  is read without echo; '*' masking is only available where
  single-character terminal control is supported.

Examples:
  lesspass site login masterpassword
  lesspass site login masterpassword -L 20 -d
  lesspass --ask
  echo "mypass" | lesspass site login -F -
""".format(version=__version__)


def _read_master_password_from_file(path):
    if path == "-":
        return sys.stdin.read()
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


class _Parser(argparse.ArgumentParser):
    """ArgumentParser with LessPass-style error/help formatting."""

    def error(self, message):
        sys.stderr.write("error: %s\n" % message)
        sys.stderr.write("Run with --help for usage.\n")
        sys.stderr.flush()
        sys.exit(2)

    def print_help(self, file=None):
        if file is None:
            file = sys.stdout
        file.write(HELP_TEXT)
        file.flush()


def _parse_args(argv):
    parser = _Parser(
        usage="lesspass [SITE] [LOGIN] [MASTER_PASSWORD] [OPTIONS]",
        add_help=False,
    )

    parser.add_argument("-h", "--help", action="help",
                        help=argparse.SUPPRESS)
    parser.add_argument("-v", "--version", action="version",
                        version=__version__)

    parser.add_argument("site", nargs="?", default=None)
    parser.add_argument("login", nargs="?", default=None)
    parser.add_argument("master_password", nargs="?", default=None)

    parser.add_argument("-F", "--file", dest="master_password_file",
                        metavar="FILE", default=None)
    parser.add_argument("--ask", action="store_true")
    parser.add_argument("--no-mask", "--no-fingerprint",
                        dest="no_mask", action="store_true")

    # -L and -C are kept as raw strings here so we can emit LessPass-style
    # error text (rather than argparse's default "invalid int value").
    parser.add_argument("-L", "--length", default=None, metavar="[5-35]")
    parser.add_argument("-C", "--counter", default=None, metavar="N")
    parser.add_argument("--exclude", default=None)

    parser.add_argument("-l", "--lowercase", action="store_true")
    parser.add_argument("-u", "--uppercase", action="store_true")
    parser.add_argument("-d", "--digits", action="store_true")
    parser.add_argument("-s", "--symbols", action="store_true")
    parser.add_argument("--no-lowercase", action="store_true")
    parser.add_argument("--no-uppercase", action="store_true")
    parser.add_argument("--no-digits", action="store_true")
    parser.add_argument("--no-symbols", action="store_true")

    args = parser.parse_args(argv)

    if args.length is None:
        args.length = 16
    else:
        try:
            length_val = int(args.length)
        except ValueError:
            sys.stderr.write("error: length must be an integer\n")
            sys.exit(2)
        if length_val < 5 or length_val > 35:
            sys.stderr.write(
                "error: length is out of range, choose in [5-35]\n"
            )
            sys.exit(2)
        args.length = length_val

    if args.counter is None:
        args.counter = 1
    else:
        try:
            args.counter = int(args.counter)
        except ValueError:
            sys.stderr.write("error: counter must be an integer\n")
            sys.exit(2)

    return args


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def _main(argv):
    args = _parse_args(argv)

    stdin_available = sys.stdin.isatty()

    def read_secret(prompt):
        """Masked by default; no-echo when --no-mask was given."""
        return _read_secret(prompt, mask=not args.no_mask)

    # Refuse ambiguous master-password sources up front.
    if args.master_password_file is not None and args.master_password is not None:
        sys.stderr.write(
            "error: master password supplied both as a positional argument "
            "and via -F; choose one\n"
        )
        sys.exit(2)

    # --ask needs an interactive terminal, but -F - consumes stdin; reject
    # the combination before touching stdin.
    if args.ask and args.master_password_file == "-":
        sys.stderr.write(
            "error: --ask cannot be combined with -F - because -F - consumes stdin\n"
        )
        sys.exit(2)

    # -F resolution.  "-" consumes stdin, so no further prompting is possible.
    if args.master_password_file == "-":
        try:
            args.master_password = _read_master_password_from_file("-")
        except Exception as e:
            sys.stderr.write(
                "error: cannot read master password from stdin: %s\n" % e
            )
            sys.exit(1)
        args.master_password_file = None
        stdin_available = False
    elif args.master_password_file:
        try:
            args.master_password = _read_master_password_from_file(
                args.master_password_file
            )
        except Exception as e:
            sys.stderr.write(
                "error: cannot read master password file: %s\n" % e
            )
            sys.exit(1)

    # --ask: edit all three interactively (blank keeps the current value).
    if args.ask:
        if not stdin_available:
            sys.stderr.write(
                "error: --ask requires an interactive terminal\n"
            )
            sys.exit(1)

        if args.site is not None:
            sys.stderr.write("Site [%s]: " % args.site)
            sys.stderr.flush()
            site = _read_line_from_stdin()
            site = "" if site is None else site.strip()
            if not site:
                site = args.site
        else:
            sys.stderr.write("Site: ")
            sys.stderr.flush()
            site = _read_line_from_stdin()
            site = "" if site is None else site.strip()
        if not site:
            sys.stderr.write("error: Site is required\n")
            sys.exit(1)

        if args.login is not None:
            sys.stderr.write("Login [%s]: " % args.login)
            sys.stderr.flush()
            login = _read_line_from_stdin()
            login = "" if login is None else login.strip()
            if not login:
                login = args.login
        else:
            sys.stderr.write("Login: ")
            sys.stderr.flush()
            login = _read_line_from_stdin()
            login = "" if login is None else login.strip()
        if not login:
            sys.stderr.write("error: Login is required\n")
            sys.exit(1)

        if args.master_password is not None:
            mp = read_secret(
                "Master Password (leave blank to keep current): "
            )
            if not mp:
                mp = args.master_password
        else:
            mp = read_secret("Master Password: ")
        if not mp:
            sys.stderr.write("error: Master Password is required\n")
            sys.exit(1)

        args.site = site
        args.login = login
        args.master_password = mp

    # Every parameter must have a concrete value: from CLI, from -F, or (when
    # stdin is a TTY) prompted for.  Otherwise -> hard error.
    def resolve(name, value, secret=False):
        if value is not None:
            return value
        if stdin_available:
            if secret:
                v = read_secret("%s: " % name)
            else:
                sys.stderr.write("%s: " % name)
                sys.stderr.flush()
                v = _read_line_from_stdin()
                v = "" if v is None else v.strip()
            if v:
                return v
        sys.stderr.write(
            "error: %s is required (not provided and cannot prompt)\n" % name
        )
        sys.exit(4)

    site = resolve("Site", args.site)
    login = resolve("Login", args.login)
    master_password = resolve(
        "Master Password", args.master_password, secret=True
    )

    # Character set selection (default: all four).
    positive_flags = (
        args.lowercase or args.uppercase or args.digits or args.symbols
    )
    if positive_flags:
        profile = {
            "lowercase": args.lowercase,
            "uppercase": args.uppercase,
            "digits": args.digits,
            "symbols": args.symbols,
        }
    else:
        profile = {
            "lowercase": True,
            "uppercase": True,
            "digits": True,
            "symbols": True,
        }

    if args.no_lowercase:
        profile["lowercase"] = False
    if args.no_uppercase:
        profile["uppercase"] = False
    if args.no_digits:
        profile["digits"] = False
    if args.no_symbols:
        profile["symbols"] = False

    if not any(profile.values()):
        sys.stderr.write("error: you can't exclude all chars available\n")
        sys.exit(6)

    profile["site"] = site
    profile["login"] = login
    profile["counter"] = args.counter
    profile["length"] = args.length
    if args.exclude is not None:
        profile["exclude"] = args.exclude

    try:
        password = generate_password(profile, master_password)
    except ExcludeAllCharsAvailable:
        sys.stderr.write("error: you can't exclude all chars available\n")
        sys.exit(6)

    sys.stdout.write(password + "\n")
    sys.stdout.flush()


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    try:
        _main(argv)
    except KeyboardInterrupt:
        # Clean abort on Ctrl-C.  Raw-mode readers already restored the
        # terminal in their finally-block; we just print a newline and use
        # the conventional 128+SIGINT exit code.
        sys.stderr.write("\n")
        sys.stderr.flush()
        sys.exit(130)
    except EOFError:
        # Ctrl-D on an empty line: clean abort with no traceback.
        sys.stderr.write("\n")
        sys.stderr.flush()
        sys.exit(1)
    except BrokenPipeError:
        # stdout was closed (e.g. piped to `head`); avoid the extra
        # traceback that sys.exit() would otherwise trigger.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except Exception:
            pass
        sys.exit(1)


if __name__ == "__main__":
    main()