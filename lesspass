#!/usr/bin/env python3
"""
Single-file LessPass CLI (password derivation only).

Usage:
  lesspass SITE LOGIN MASTER_PASSWORD [OPTIONS]
  lesspass SITE LOGIN -F MASTER_PASSWORD_FILE [OPTIONS]
  echo "mypass" | lesspass SITE LOGIN -F - [OPTIONS]
  lesspass --ask [OPTIONS]

The three parameters SITE, LOGIN, MASTER_PASSWORD must be supplied on the
command line, resolved from a file via -F, or entered interactively.  Missing
values are prompted for when stdin is a TTY; otherwise an error is reported.
--ask forces interactive editing of all three even when they are already
supplied.
"""

import argparse
import getpass
import hashlib
import sys

__version__ = "10.2.1"

# ---------------------------------------------------------------------------
# Password derivation core (from LessPass)
# ---------------------------------------------------------------------------

CHARACTER_SUBSETS = {
    "lowercase": "abcdefghijklmnopqrstuvwxyz",
    "uppercase": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "digits": "0123456789",
    "symbols": "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
}


class ExcludeAllCharsAvailable(Exception):
    pass


def _calc_entropy(password_profile, master_password):
    salt = (
        password_profile["site"]
        + password_profile["login"]
        + hex(password_profile["counter"])[2:]
    )
    hex_entropy = hashlib.pbkdf2_hmac(
        "sha256",
        master_password.encode("utf-8"),
        salt.encode("utf-8"),
        100000,
        32,
    ).hex()
    return int(hex_entropy, 16)


def _remove_excluded_chars(string, exclude):
    new_string = "".join(c for c in string if c not in exclude)
    if len(new_string) == 0:
        raise ExcludeAllCharsAvailable
    return new_string


def _get_set_of_characters(rules=None, exclude=""):
    if rules is None:
        return (
            CHARACTER_SUBSETS["lowercase"]
            + CHARACTER_SUBSETS["uppercase"]
            + CHARACTER_SUBSETS["digits"]
            + CHARACTER_SUBSETS["symbols"]
        )
    pool_of_chars = ""
    for rule in rules:
        pool_of_chars += CHARACTER_SUBSETS[rule]
    return _remove_excluded_chars(pool_of_chars, exclude)


def _consume_entropy(generated_password, quotient, set_of_characters, max_length):
    if len(generated_password) >= max_length:
        return [generated_password, quotient]
    quotient, remainder = divmod(quotient, len(set_of_characters))
    generated_password += set_of_characters[remainder]
    return _consume_entropy(generated_password, quotient, set_of_characters, max_length)


def _insert_string_pseudo_randomly(generated_password, entropy, string):
    for letter in string:
        quotient, remainder = divmod(entropy, len(generated_password))
        generated_password = (
            generated_password[:remainder] + letter + generated_password[remainder:]
        )
        entropy = quotient
    return generated_password


def _get_one_char_per_rule(entropy, rules, exclude=""):
    one_char_per_rules = ""
    for rule in rules:
        available_chars = _remove_excluded_chars(CHARACTER_SUBSETS[rule], exclude)
        value, entropy = _consume_entropy("", entropy, available_chars, 1)
        one_char_per_rules += value
    return [one_char_per_rules, entropy]


def _get_configured_rules(password_profile):
    rules = ["lowercase", "uppercase", "digits", "symbols"]
    return [rule for rule in rules if password_profile.get(rule)]


def _render_password(entropy, password_profile):
    rules = _get_configured_rules(password_profile)
    excluded_chars = password_profile.get("exclude", "")
    set_of_characters = _get_set_of_characters(rules, excluded_chars)
    password, password_entropy = _consume_entropy(
        "", entropy, set_of_characters, password_profile["length"] - len(rules)
    )
    characters_to_add, character_entropy = _get_one_char_per_rule(
        password_entropy, rules, excluded_chars
    )
    return _insert_string_pseudo_randomly(
        password, character_entropy, characters_to_add
    )


def generate_password(password_profile, master_password):
    entropy = _calc_entropy(password_profile, master_password)
    return _render_password(entropy, password_profile)


# ---------------------------------------------------------------------------
# CLI helpers
# ---------------------------------------------------------------------------

def _range_type(value_string):
    value = int(value_string)
    if value not in range(5, 35 + 1):
        raise argparse.ArgumentTypeError("%s is out of range, choose in [5-35]" % value)
    return value


def _read_master_password_from_file(path):
    if path == "-":
        return sys.stdin.read().rstrip("\n")
    with open(path, "r", encoding="utf-8") as f:
        return f.read().rstrip("\n")


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def parse_args(args):
    parser = argparse.ArgumentParser(
        usage="lesspass [SITE] [LOGIN] [MASTER_PASSWORD] [OPTIONS]",
        description="LessPass - stateless password generator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  lesspass site login masterpassword
  lesspass site login masterpassword -L 20 -d
  lesspass --ask
  echo "mypass" | lesspass site login -F -
""",
    )

    parser.add_argument("-v", "--version", action="version", version=__version__)

    parser.add_argument("site", nargs="?", default=None,
                        help="site used in the password generation")
    parser.add_argument("login", nargs="?", default=None,
                        help="login used in the password generation")
    parser.add_argument("master_password", nargs="?", default=None,
                        help="master password (prefer -F or interactive prompt)")

    parser.add_argument(
        "-F", "--file",
        dest="master_password_file",
        metavar="FILE",
        help="read master password from FILE (use '-' for stdin)",
    )

    parser.add_argument(
        "--ask",
        action="store_true",
        help="interactively edit all three parameters even if supplied",
    )

    parser.add_argument("-L", "--length", default=16, choices=range(5, 35 + 1),
                        type=_range_type,
                        help="password length (default: 16, min: 5, max: 35)",
                        metavar="[5-35]")
    parser.add_argument("-C", "--counter", default=1, type=int,
                        help="password counter (default: 1)")
    parser.add_argument("--exclude", default=None,
                        help="exclude chars from generated password")
    parser.add_argument("-l", "--lowercase", action="store_true",
                        help="add lowercase in password")
    parser.add_argument("-u", "--uppercase", action="store_true",
                        help="add uppercase in password")
    parser.add_argument("-d", "--digits", action="store_true",
                        help="add digits in password")
    parser.add_argument("-s", "--symbols", action="store_true",
                        help="add symbols in password")
    parser.add_argument("--no-lowercase", action="store_true",
                        help="remove lowercase from password")
    parser.add_argument("--no-uppercase", action="store_true",
                        help="remove uppercase from password")
    parser.add_argument("--no-digits", action="store_true",
                        help="remove digits from password")
    parser.add_argument("--no-symbols", action="store_true",
                        help="remove symbols from password")

    return parser.parse_args(args)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(args=None):
    if args is None:
        args = sys.argv[1:]
    args = parse_args(args)

    stdin_available = sys.stdin.isatty()

    # -F resolution.  "-" consumes stdin so no further prompting is possible.
    if args.master_password_file == "-":
        try:
            args.master_password = _read_master_password_from_file("-")
        except Exception as e:
            print(f"error: cannot read master password from stdin: {e}",
                  file=sys.stderr)
            sys.exit(1)
        args.master_password_file = None
        stdin_available = False
    elif args.master_password_file:
        try:
            args.master_password = _read_master_password_from_file(
                args.master_password_file)
        except Exception as e:
            print(f"error: cannot read master password file: {e}",
                  file=sys.stderr)
            sys.exit(1)

    # --ask : edit all three interactively.
    if args.ask:
        if not stdin_available:
            print("error: --ask requires an interactive terminal",
                  file=sys.stderr)
            sys.exit(1)
        site = input(f"Site [{args.site}]: ").strip() if args.site else \
               input("Site: ").strip()
        if not site:
            print("error: Site is required", file=sys.stderr)
            sys.exit(1)
        login = input(f"Login [{args.login}]: ").strip() if args.login else \
                input("Login: ").strip()
        if not login:
            print("error: Login is required", file=sys.stderr)
            sys.exit(1)
        if args.master_password:
            mp = getpass.getpass(
                "Master Password (leave blank to keep current): ")
            if not mp:
                mp = args.master_password
        else:
            mp = getpass.getpass("Master Password: ")
        if not mp:
            print("error: Master Password is required", file=sys.stderr)
            sys.exit(1)
        args.site, args.login, args.master_password = site, login, mp

    # Every parameter must have a concrete value: from CLI, from -F, or (when
    # stdin is a TTY) prompted for.  Otherwise -> hard error.
    def resolve(name, value, secret=False):
        if value is not None:
            return value
        if stdin_available:
            if secret:
                v = getpass.getpass(f"{name}: ")
            else:
                v = input(f"{name}: ").strip()
            if v:
                return v
        print(f"error: {name} is required (not provided and cannot prompt)",
              file=sys.stderr)
        sys.exit(4)

    site = resolve("Site", args.site)
    login = resolve("Login", args.login)
    master_password = resolve("Master Password", args.master_password,
                              secret=True)

    # Character set selection (default: all four).
    positive_flags = args.lowercase or args.uppercase or args.digits or args.symbols
    if positive_flags:
        profile = {
            "lowercase": args.lowercase,
            "uppercase": args.uppercase,
            "digits": args.digits,
            "symbols": args.symbols,
        }
    else:
        profile = {"lowercase": True, "uppercase": True,
                   "digits": True, "symbols": True}

    if args.no_lowercase: profile["lowercase"] = False
    if args.no_uppercase: profile["uppercase"] = False
    if args.no_digits:    profile["digits"] = False
    if args.no_symbols:   profile["symbols"] = False

    if not any(profile.values()):
        print("error: you can't exclude all chars available", file=sys.stderr)
        sys.exit(6)

    profile["site"] = site
    profile["login"] = login
    profile["counter"] = args.counter
    profile["length"] = args.length
    if args.exclude is not None:
        profile["exclude"] = args.exclude

    try:
        password = generate_password(profile, master_password)
    except ExcludeAllCharsAvailable:
        print("error: you can't exclude all chars available", file=sys.stderr)
        sys.exit(6)

    print(password)


if __name__ == "__main__":
    main()
