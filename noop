#!/usr/bin/env python3
"""noop - Validate a single audio stream on stdin, estimate loudness gain, and output processed audio.

Reads standard input, verifies via ffprobe that it contains exactly one audio stream,
computes the gain required to reach -20 dB loudness using SoX, applies that gain
together with optional resampling and dithering, and writes the result to stdout.
Diagnostic output from ffprobe, ffmpeg and SoX is forwarded to stderr on failure
(or always when ``--debug`` is given).  An optional positional argument specifies
the target sample rate (default 44100 Hz).  With ``--keep-input-bitdepth-if-8bit``,
8‑bit unsigned input is left at its original bit depth instead of being promoted
to 16‑bit.

With ``--debug``, every subprocess command line is logged to stderr.
"""
import sys
import subprocess
import json
import argparse
import shutil
from typing import Optional, Dict, List, Tuple


def parse_args() -> argparse.Namespace:
    """Parse command‑line arguments."""
    parser = argparse.ArgumentParser(
        description="Verify a single audio stream on stdin and output gain‑adjusted audio."
    )
    parser.add_argument(
        "sample_rate",
        nargs="?",
        type=int,
        default=44100,
        help="Target sample rate (default: 44100)",
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        default=False,
        help="Always print captured stderr of subprocesses and log commands",
    )
    parser.add_argument(
        "--keep-input-bitdepth-if-8bit",
        action="store_true",
        default=False,
        help="For u8 input, keep 8‑bit depth instead of converting to 16‑bit",
    )
    return parser.parse_args()


def _get_audio_stream_info(ffprobe_stdout: bytes) -> Optional[Dict]:
    """Extract the **first** audio stream's metadata from ffprobe JSON output."""
    try:
        data = json.loads(ffprobe_stdout.decode("utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None
    streams = data.get("streams", [])
    for s in streams:
        if s.get("codec_type") == "audio":
            return {
                "codec_name": s.get("codec_name", ""),
                "sample_rate": int(s.get("sample_rate", 0)),
                "sample_fmt": s.get("sample_fmt", ""),
            }
    return None


def _exactly_one_audio_stream(ffprobe_stdout: bytes) -> bool:
    """Return True if the JSON contains exactly one audio stream."""
    return _get_audio_stream_info(ffprobe_stdout) is not None


def build_gain_estimation_sox_cmd(
    input_type: str,
    sample_fmt: str,
    src_sample_rate: int,
    target_sample_rate: int,
) -> List[str]:
    """Construct the SoX command line used for gain estimation.

    Dither is omitted for u8 input because it makes no sense.
    """
    cmd = ["sox", "-D", "-t", input_type, "-"]

    if sample_fmt not in ("s16", "s16p"):
        cmd.append("-b16")

    cmd.extend(["-n", "vol", "-20dB"])

    if src_sample_rate != target_sample_rate:
        cmd.extend(["rate", str(target_sample_rate)])

    if sample_fmt not in ("s16", "s16p", "u8"):
        cmd.append("dither")

    other_rate = 44100 if target_sample_rate == 48000 else 48000
    cmd.extend(["rate", "-m", str(other_rate), "stats"])

    return cmd


def build_production_sox_cmd(
    input_type: str,
    sample_fmt: str,
    src_sample_rate: int,
    target_sample_rate: int,
    attenuation_db: float,
    keep_8bit: bool,
) -> Optional[List[str]]:
    """Construct the SoX command line for final audio production.

    Returns ``None`` when no processing is needed (no volume change,
    no resampling, and no dithering/bit‑depth conversion).
    """
    need_vol = attenuation_db != 0.0
    need_resample = src_sample_rate != target_sample_rate

    is_u8 = sample_fmt == "u8"
    need_b16 = sample_fmt not in ("s16", "s16p") and not (is_u8 and keep_8bit)

    # Dither added when converting to 16‑bit (i.e. not already 16‑bit and not u8)
    need_dither = sample_fmt not in ("s16", "s16p", "u8")

    if not (need_vol or need_resample or need_b16 or need_dither):
        return None

    cmd = ["sox", "-D", "-t", input_type, "-"]

    if need_b16:
        cmd.append("-b16")

    cmd.append("-")  # output to stdout

    if need_vol:
        cmd.extend(["vol", f"{attenuation_db:.1f}dB"])

    if need_resample:
        cmd.extend(["rate", str(target_sample_rate)])

    if need_dither:
        cmd.append("dither")

    return cmd


def parse_peak_from_stats(sox_stderr: bytes) -> Optional[float]:
    """Extract the peak level (dB) from the SoX stats effect output."""
    lines = sox_stderr.decode("utf-8", errors="replace").splitlines()
    for line in lines:
        if line.startswith("Pk lev dB"):
            parts = line.split()
            if len(parts) >= 4:
                try:
                    return float(parts[3])
                except ValueError:
                    pass
    return None


def compute_attenuation(peak_db: Optional[float]) -> float:
    """Calculate required attenuation.

    If the peak cannot be determined, returns 0.0 (no change).
    """
    if peak_db is None:
        return 0.0
    # Required attenuation = (peak level relative to -20 dB), plus 0.1 dB margin
    att = 20.0 + peak_db
    if att > 0.0:
        att += 0.1
    else:
        att = 0.0
    # SoX “vol” uses negative values for attenuation
    return -att


def _log_cmd(cmd: List[str], debug: bool) -> None:
    """Print the command line to stderr if debug is enabled."""
    if debug:
        print("RUN:", " ".join(cmd), file=sys.stderr)


def _maybe_dump_stderr(stderr_data: bytes, proc_name: str, exit_code: int, debug: bool) -> None:
    """Write captured stderr to the script's stderr if debugging or the command failed."""
    if stderr_data and (debug or exit_code != 0):
        sys.stderr.buffer.write(
            f"--- {proc_name} stderr (exit {exit_code}) ---\n".encode()
        )
        sys.stderr.buffer.write(stderr_data)
        if not stderr_data.endswith(b"\n"):
            sys.stderr.buffer.write(b"\n")
        sys.stderr.buffer.write(b"--- end ---\n")
        sys.stderr.buffer.flush()


def _check_return_code(exit_code: int, proc_name: str, stderr_data: bytes, debug: bool) -> None:
    """Exit with an error if *exit_code* is non‑zero, dumping stderr first."""
    _maybe_dump_stderr(stderr_data, proc_name, exit_code, debug)
    if exit_code != 0:
        print(f"Error: {proc_name} failed with exit code {exit_code}", file=sys.stderr)
        sys.exit(1)


def run_ffprobe_seekable(args: List[str], debug: bool) -> bytes:
    """Run ffprobe on a seekable stdin, rewinding afterwards."""
    _log_cmd(args, debug)
    proc = subprocess.Popen(
        args,
        stdin=sys.stdin.buffer,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    stdout, stderr = proc.communicate()
    _check_return_code(proc.returncode, "ffprobe", stderr, debug)
    sys.stdin.buffer.seek(0)
    return stdout


def run_ffprobe_nonseekable(args: List[str], debug: bool) -> Tuple[bytes, bytes]:
    """Run ffprobe on a non‑seekable stdin, buffering the entire input.

    Returns the ffprobe stdout and the buffered original data.
    """
    _log_cmd(args, debug)
    proc = subprocess.Popen(
        args,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    buffer_chunks: List[bytes] = []
    early_check = False
    write_to_ffprobe = True

    while True:
        chunk = sys.stdin.buffer.read(128 * 1024)
        if not chunk:
            break
        buffer_chunks.append(chunk)

        if write_to_ffprobe:
            try:
                proc.stdin.write(chunk)
                proc.stdin.flush()
            except BrokenPipeError:
                pass

            if proc.poll() is not None:
                ffprobe_stdout = proc.stdout.read()
                ret = proc.returncode
                if ret != 0 or not _exactly_one_audio_stream(ffprobe_stdout):
                    stderr_tail = proc.stderr.read()
                    _maybe_dump_stderr(stderr_tail, "ffprobe", ret, debug)
                    print(
                        "Error: input must contain exactly one audio stream.",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                write_to_ffprobe = False
                early_check = True

    if not early_check:
        proc.stdin.close()
        ffprobe_stdout, stderr = proc.communicate()
        _check_return_code(proc.returncode, "ffprobe", stderr, debug)
        if not _exactly_one_audio_stream(ffprobe_stdout):
            print(
                "Error: input must contain exactly one audio stream.",
                file=sys.stderr,
            )
            sys.exit(1)
    else:
        # consume remaining stderr
        stderr_tail = proc.stderr.read()
        ffprobe_stdout = ffprobe_stdout  # already captured

    original_data = b"".join(buffer_chunks)
    del buffer_chunks
    return ffprobe_stdout, original_data


def main() -> None:
    args = parse_args()
    target_sr = args.sample_rate
    debug = args.debug
    keep_8bit = args.keep_input_bitdepth_if_8bit

    if sys.stdin.isatty():
        print(
            "Error: stdin is a terminal, input must be piped or redirected.",
            file=sys.stderr,
        )
        sys.exit(1)

    ffprobe_args = [
        "ffprobe",
        "-v",
        "warning",
        "-hide_banner",
        "-print_format",
        "json",
        "-show_streams",
        "-i",
        "-",
    ]

    # ------------------------------------------------------------------
    # Phase 1 – ffprobe & data acquisition
    # ------------------------------------------------------------------
    seekable = sys.stdin.buffer.seekable()
    if seekable:
        ffprobe_stdout = run_ffprobe_seekable(ffprobe_args, debug)
        original_data = None
    else:
        ffprobe_stdout, original_data = run_ffprobe_nonseekable(ffprobe_args, debug)

    stream_info = _get_audio_stream_info(ffprobe_stdout)
    if stream_info is None:
        print(
            "Error: input must contain exactly one audio stream.",
            file=sys.stderr,
        )
        sys.exit(1)

    codec = stream_info["codec_name"]
    src_sr = stream_info["sample_rate"]
    fmt = stream_info["sample_fmt"]
    needs_convert = codec not in ("wav", "flac")

    # ------------------------------------------------------------------
    # Phase 2 – Gain estimation
    # ------------------------------------------------------------------
    if seekable:
        sys.stdin.buffer.seek(0)

        def run_sox_with_input(stdin_src, input_type):
            cmd = build_gain_estimation_sox_cmd(input_type, fmt, src_sr, target_sr)
            _log_cmd(cmd, debug)
            return subprocess.Popen(
                cmd,
                stdin=stdin_src,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )

        if needs_convert:
            ffmpeg_cmd = [
                "ffmpeg",
                "-hide_banner",
                "-xerror",
                "-err_detect",
                "explode",
                "-loglevel",
                "warning",
                "-i",
                "-",
                "-f",
                "wav",
                "pipe:1",
            ]
            _log_cmd(ffmpeg_cmd, debug)
            ffmpeg_proc = subprocess.Popen(
                ffmpeg_cmd,
                stdin=sys.stdin.buffer,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            sox_proc = run_sox_with_input(ffmpeg_proc.stdout, "wav")
            ffmpeg_proc.stdout.close()

            sox_stderr = sox_proc.communicate()[1]
            ffmpeg_stderr = ffmpeg_proc.communicate()[1]

            _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)
            _check_return_code(ffmpeg_proc.returncode, "ffmpeg", ffmpeg_stderr, debug)
        else:
            input_type = "flac" if codec == "flac" else "wav"
            sox_proc = run_sox_with_input(sys.stdin.buffer, input_type)
            sox_stderr = sox_proc.communicate()[1]
            _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)
    else:
        # non‑seekable
        if needs_convert:
            ffmpeg_cmd = [
                "ffmpeg",
                "-hide_banner",
                "-xerror",
                "-err_detect",
                "explode",
                "-loglevel",
                "warning",
                "-i",
                "-",
                "-f",
                "wav",
                "pipe:1",
            ]
            _log_cmd(ffmpeg_cmd, debug)
            ffmpeg_proc = subprocess.Popen(
                ffmpeg_cmd,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            converted_wav, ffmpeg_stderr = ffmpeg_proc.communicate(input=original_data)
            _check_return_code(ffmpeg_proc.returncode, "ffmpeg", ffmpeg_stderr, debug)
            del original_data
            data_for_sox = converted_wav
            input_type = "wav"
        else:
            data_for_sox = original_data
            input_type = "flac" if codec == "flac" else "wav"

        sox_cmd = build_gain_estimation_sox_cmd(input_type, fmt, src_sr, target_sr)
        _log_cmd(sox_cmd, debug)
        sox_proc = subprocess.Popen(
            sox_cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
        sox_stderr = sox_proc.communicate(input=data_for_sox)[1]
        _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)

    # Parse loudness statistics.
    if debug and sox_stderr:
        sys.stderr.buffer.write(sox_stderr)
        sys.stderr.buffer.flush()

    peak_db = parse_peak_from_stats(sox_stderr)
    attenuation_val = compute_attenuation(peak_db)

    # ------------------------------------------------------------------
    # Phase 3 – Final audio production
    # ------------------------------------------------------------------
    production_input_type = "wav" if needs_convert else ("flac" if codec == "flac" else "wav")
    need_sox_cmd = build_production_sox_cmd(
        production_input_type,
        fmt,
        src_sr,
        target_sr,
        attenuation_val,
        keep_8bit,
    )

    if seekable:
        sys.stdin.buffer.seek(0)

        if needs_convert:
            ffmpeg_cmd = [
                "ffmpeg",
                "-hide_banner",
                "-xerror",
                "-err_detect",
                "explode",
                "-loglevel",
                "warning",
                "-i",
                "-",
                "-f",
                "wav",
                "pipe:1",
            ]
            _log_cmd(ffmpeg_cmd, debug)
            ffmpeg_proc = subprocess.Popen(
                ffmpeg_cmd,
                stdin=sys.stdin.buffer,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )

            if need_sox_cmd is not None:
                _log_cmd(need_sox_cmd, debug)
                sox_proc = subprocess.Popen(
                    need_sox_cmd,
                    stdin=ffmpeg_proc.stdout,
                    stdout=sys.stdout.buffer,
                    stderr=subprocess.PIPE,
                )
                ffmpeg_proc.stdout.close()
                sox_stderr = sox_proc.communicate()[1]
                ffmpeg_stderr = ffmpeg_proc.communicate()[1]
                _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)
                _check_return_code(ffmpeg_proc.returncode, "ffmpeg", ffmpeg_stderr, debug)
            else:
                ffmpeg_proc.stdout.close()
                shutil.copyfileobj(ffmpeg_proc.stdout, sys.stdout.buffer)
                ffmpeg_stderr = ffmpeg_proc.communicate()[1]
                _check_return_code(ffmpeg_proc.returncode, "ffmpeg", ffmpeg_stderr, debug)
        else:
            # Already WAV/FLAC
            if need_sox_cmd is not None:
                _log_cmd(need_sox_cmd, debug)
                sox_proc = subprocess.Popen(
                    need_sox_cmd,
                    stdin=sys.stdin.buffer,
                    stdout=sys.stdout.buffer,
                    stderr=subprocess.PIPE,
                )
                sox_stderr = sox_proc.communicate()[1]
                _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)
            else:
                shutil.copyfileobj(sys.stdin.buffer, sys.stdout.buffer)
    else:
        # Non‑seekable: final data is still in memory.
        if needs_convert:
            data = data_for_sox  # converted WAV
        else:
            data = original_data

        if need_sox_cmd is not None:
            _log_cmd(need_sox_cmd, debug)
            sox_proc = subprocess.Popen(
                need_sox_cmd,
                stdin=subprocess.PIPE,
                stdout=sys.stdout.buffer,
                stderr=subprocess.PIPE,
            )
            sox_stderr = sox_proc.communicate(input=data)[1]
            _check_return_code(sox_proc.returncode, "sox", sox_stderr, debug)
        else:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()

    sys.exit(0)


if __name__ == "__main__":
    main()
